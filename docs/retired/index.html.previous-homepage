          <rect x="16" y="20" width="198" height="242" rx="4" fill="none" stroke="var(--manila-dark)" stroke-width="1.8"/>
          <rect x="16" y="20" width="198" height="34" fill="#D9C286"/>
          <text x="32" y="43" font-family="Figtree, sans-serif" font-weight="600" font-size="14" fill="#5E4E28">PROPERTY RECORD</text>
          <!-- parcel thumbnail -->
          <rect x="32" y="66" width="76" height="62" fill="#F6EEDA" stroke="var(--manila-dark)" stroke-width="1.2"/>
          <path d="M40 118 h24 v-26 h20 v-14 h16" fill="none" stroke="#A8895180" stroke-width="1.4"/>
          <path d="M46 110 h20 v-18 h14" fill="none" stroke="#8A6F3C" stroke-width="2"/>
          <rect x="52" y="92" width="16" height="14" fill="#B0472F" opacity="0.75"/>
          <text x="70" y="140" font-family="DM Mono, monospace" font-size="9"
                fill="#8A7A54" text-anchor="middle">PARCEL</text>
          <!-- compliance rows -->
          <g font-family="Figtree, sans-serif" font-size="12" fill="#5E4E28">
            <text x="122" y="78">Permits</text><text x="122" y="102">Taxes</text>
            <text x="122" y="126">Inspection</text><text x="122" y="150">Court</text>
          </g>
          <g stroke="#7A9B5E" stroke-width="2.4" fill="none" stroke-linecap="round">
            <path d="M186 72 l4 5 l8 -10"/><path d="M186 96 l4 5 l8 -10"/><path d="M186 144 l4 5 l8 -10"/>
          </g>
          <g stroke="#B0472F" stroke-width="2.4" stroke-linecap="round">
            <line x1="186" y1="116" x2="197" y2="127"/><line x1="197" y1="116" x2="186" y2="127"/>
          </g>
          <line x1="32" y1="162" x2="198" y2="162" stroke="var(--manila-dark)" stroke-width="1.2"/>
          <g font-family="DM Mono, monospace" font-size="10" fill="#8A7A54">
            <text x="32" y="182">WARD 3 · CLEVELAND</text>
            <text x="32" y="200">CHECKED DAILY</text>
          </g>
          <!-- the guardrail, stamped on the object itself -->
          <g transform="rotate(-9 118 232)">
            <rect x="52" y="212" width="132" height="34" rx="3" fill="none" stroke="#B0472F" stroke-width="2.4" opacity="0.72"/>
            <text x="118" y="235" font-family="Figtree, sans-serif" font-weight="600" font-size="14"
                  fill="#B0472F" opacity="0.78" text-anchor="middle">NO REVENUE YET</text>
          </g>
        </g>`,
    },
  ];

  /* =========================================================
     Build the DOM
     ========================================================= */
  const nodes = [];
  OBJECTS.forEach((o, i) => {
    const el = document.createElement("div");
    el.className = "obj";
    el.tabIndex = 0;
    el.setAttribute("role", "button");
    el.setAttribute("aria-label", `${o.note}. ${o.say}`);
    el.innerHTML =
      `<svg width="${o.w}" height="${o.h}" viewBox="0 0 ${o.w} ${o.h}" aria-hidden="true">${o.art}</svg>` +
      `<div class="tag">${o.note}</div>` +
      `<div class="say-more"><p>${o.say}</p>${o.num ? `<span class="n">${o.num}</span>` : ""}</div>`;
    bench.appendChild(el);
    nodes.push({ ...o, el, x: 0, y: 0, vx: 0, vy: 0, a: 0, va: 0, held: false, z: i, version: 2 });
  });

  /* Scatter, overlapping and rotated, like things put down in a hurry. */
  function layout() {
    const W = bench.clientWidth, H = bench.clientHeight;
    const spots = W < 640
      ? [[0.32,0.11],[0.68,0.26],[0.30,0.44],[0.70,0.60],[0.34,0.76],[0.66,0.91]]
      : [[0.19,0.36],[0.40,0.22],[0.63,0.30],[0.30,0.71],[0.55,0.63],[0.80,0.62]];
    const tilt = [-9, 6, -4, 11, -13, 5];
    nodes.forEach((n, i) => {
      n.x = spots[i][0] * W;
      n.y = spots[i][1] * H;
      n.a = tilt[i];
      n.vx = n.vy = n.va = 0;
      clamp(n, W, H);
      draw(n);
    });
  }

  function clamp(n, W, H) {
    n.x = Math.max(n.r, Math.min(W - n.r, n.x));
    n.y = Math.max(n.r, Math.min(H - n.r, n.y));
  }

  function draw(n) {
    n.el.style.transform =
      `translate(${n.x - n.w / 2}px, ${n.y - n.h / 2}px) rotate(${n.a}deg)`;
    // The reveal and the tag stay level no matter how the object lies.
    // Annotations lean a little, but never with the object: something
    // written on the bench does not rotate when the thing on top of it does.
    const t = n.el.querySelector(".tag");
    t.style.left = `${n.w / 2 + (n.nx ?? 0) * 4}px`;
    t.style.top = `${n.h + 6 + (n.ny ?? 0)}px`;
    t.style.transform = `translate(-50%, 0) rotate(${(n.na ?? 0)}deg)`;
  }

  /* =========================================================
     Physics. Top-down, so no gravity: things slide and settle.
     ========================================================= */
  let last = performance.now();
  function tick(now) {
    const dt = Math.min(2.4, (now - last) / 16.67);
    last = now;
    const W = bench.clientWidth, H = bench.clientHeight;

    for (const n of nodes) {
      if (n.held) continue;
      n.x += n.vx * dt; n.y += n.vy * dt; n.a += n.va * dt;
      n.vx *= Math.pow(n.drag, dt); n.vy *= Math.pow(n.drag, dt);
      n.va *= Math.pow(0.9, dt);
      if (Math.abs(n.vx) < 0.02) n.vx = 0;
      if (Math.abs(n.vy) < 0.02) n.vy = 0;
      if (Math.abs(n.va) < 0.02) n.va = 0;

      // walls
      let hit = 0;
      if (n.x < n.r) { n.x = n.r; n.vx = -n.vx * n.bounce; hit = Math.abs(n.vx); }
      if (n.x > W - n.r) { n.x = W - n.r; n.vx = -n.vx * n.bounce; hit = Math.abs(n.vx); }
      if (n.y < n.r) { n.y = n.r; n.vy = -n.vy * n.bounce; hit = Math.abs(n.vy); }
      if (n.y > H - n.r) { n.y = H - n.r; n.vy = -n.vy * n.bounce; hit = Math.abs(n.vy); }
      if (hit > 1.2) { n.va += (Math.random() - 0.5) * n.spin * 6; impact(n, hit); }
    }

    // pairwise, six objects, so brute force is the right amount of clever
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const A = nodes[i], B = nodes[j];
        let dx = B.x - A.x, dy = B.y - A.y;
        let d = Math.hypot(dx, dy);
        const min = A.r + B.r;
        if (d === 0) { d = 0.01; dx = 0.01; }
        if (d >= min) continue;

        const nx = dx / d, ny = dy / d, overlap = min - d;
        const total = A.mass + B.mass;
        if (!A.held) { A.x -= nx * overlap * (B.mass / total); A.y -= ny * overlap * (B.mass / total); }
        if (!B.held) { B.x += nx * overlap * (A.mass / total); B.y += ny * overlap * (A.mass / total); }

        const rvx = B.vx - A.vx, rvy = B.vy - A.vy;
        const sep = rvx * nx + rvy * ny;
        if (sep < 0) {
          const e = Math.min(A.bounce, B.bounce) + 0.35;
          const imp = -(1 + e) * sep / (1 / A.mass + 1 / B.mass);
          if (!A.held) { A.vx -= imp * nx / A.mass; A.vy -= imp * ny / A.mass; A.va -= imp * A.spin * 0.4; }
          if (!B.held) { B.vx += imp * nx / B.mass; B.vy += imp * ny / B.mass; B.va += imp * B.spin * 0.4; }
          const force = Math.abs(imp);
          if (force > 2) { impact(A, force / A.mass); impact(B, force / B.mass); }
          meeting(A, B);
        }
      }
    }

    for (const n of nodes) { clamp(n, W, H); draw(n); }
    requestAnimationFrame(tick);
  }

  /* ---- egg 1: the bracket takes a new revision every hard landing ---- */
  function impact(n, force) {
    if (n.id !== "bracket" || force < 2.4) return;
    n.version = Math.min(99, n.version + 1);
    const t = n.el.querySelector(".ver");
    if (t) t.textContent = "v" + n.version;
  }

  /* ---- egg 2: lens meets clipboard ---- */
  let noted = false;
  function meeting(A, B) {
    const ids = [A.id, B.id];
    if (!ids.includes("lens") || !ids.includes("clipboard")) return;
    note.style.left = ((A.x + B.x) / 2) + "px";
    note.style.top = ((A.y + B.y) / 2 - 58) + "px";
    note.classList.add("on");
    noted = true;
    clearTimeout(note._t);
    note._t = setTimeout(() => note.classList.remove("on"), 4200);
  }

  /* ---- egg 3: the envelope opens ---- */
  function openEnvelope(n, open) {
    const flap = n.el.querySelector(".flap");
    const slip = n.el.querySelector(".slip");
    if (!flap) return;
    flap.style.transition = "transform .42s cubic-bezier(.2,.9,.3,1.3)";
    slip.style.transition = "opacity .3s ease .12s, transform .42s cubic-bezier(.2,.9,.3,1.3) .1s";
    flap.style.transform = open ? "scaleY(-1)" : "scaleY(1)";
    slip.style.opacity = open ? "1" : "0";
    slip.style.transform = open ? "translateY(-16px)" : "translateY(0)";
  }

  /* clipboard: lift the top sheet */
  function liftSheet(n, open) {
    const s = n.el.querySelector(".sheet2");
    if (s) { s.style.transition = "opacity .3s ease"; s.style.opacity = open ? "1" : "0"; }
  }

  /* =========================================================
     Pointer: pick up, drag, throw
     ========================================================= */
  let topZ = 10;
  nodes.forEach(n => {
    let id = null, ox = 0, oy = 0, moved = 0, lx = 0, ly = 0, lt = 0;

    n.el.addEventListener("pointerdown", e => {
      id = e.pointerId;
      n.el.setPointerCapture(id);
      n.held = true; moved = 0;
      n.el.classList.add("held");
      n.el.style.zIndex = ++topZ;
      const b = bench.getBoundingClientRect();
      ox = n.x - (e.clientX - b.left); oy = n.y - (e.clientY - b.top);
      lx = e.clientX; ly = e.clientY; lt = performance.now();
      n.vx = n.vy = 0;
    });

    n.el.addEventListener("pointermove", e => {
      if (id === null || e.pointerId !== id) return;
      const b = bench.getBoundingClientRect();
      const nx = e.clientX - b.left + ox, ny = e.clientY - b.top + oy;
      moved += Math.abs(nx - n.x) + Math.abs(ny - n.y);
      n.x = nx; n.y = ny;
      const dt = Math.max(8, performance.now() - lt);
      // Throwing is a desktop pleasure; on a phone it fights scrolling.
      if (!coarse) {
        n.vx = (e.clientX - lx) / dt * 9;
        n.vy = (e.clientY - ly) / dt * 9;
        n.va = (e.clientX - lx) / dt * n.spin * 1.6;
      }
      lx = e.clientX; ly = e.clientY; lt = performance.now();
      clamp(n, bench.clientWidth, bench.clientHeight);
      draw(n);
    });

    const release = e => {
      if (id === null || (e && e.pointerId !== id)) return;
      try { n.el.releasePointerCapture(id); } catch {}
      id = null; n.held = false;
      n.el.classList.remove("held");
      if (coarse) { n.vx = n.vy = 0; }
      // A tap, not a throw: show what it is.
      if (moved < 6) toggle(n);
    };
    n.el.addEventListener("pointerup", release);
    n.el.addEventListener("pointercancel", release);

    n.el.addEventListener("keydown", e => {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggle(n); }
      const step = e.shiftKey ? 40 : 14;
      const k = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] }[e.key];
      if (k) { e.preventDefault(); n.x += k[0]; n.y += k[1]; clamp(n, bench.clientWidth, bench.clientHeight); draw(n); }
    });
  });

  function toggle(n) {
    const open = !n.el.classList.contains("open");
    nodes.forEach(o => { if (o !== n) { o.el.classList.remove("open"); openEnvelope(o, false); liftSheet(o, false); } });
    n.el.classList.toggle("open", open);
    n.el.style.zIndex = ++topZ;
    if (n.id === "envelope") openEnvelope(n, open);
    if (n.id === "clipboard") liftSheet(n, open);
  }

  bench.addEventListener("pointerdown", e => {
    if (e.target === bench) nodes.forEach(o => {
      o.el.classList.remove("open"); openEnvelope(o, false); liftSheet(o, false);
    });
  });

  layout();
  let rt; window.addEventListener("resize", () => { clearTimeout(rt); rt = setTimeout(layout, 220); });
  if (!still) requestAnimationFrame(tick);
})();
</script>
