<style>
  :root {
    --bench: #FDFBF6;
    --bench-2: #F4EFE3;
    --ink: #201E1B;
    --muted: #6B645B;
    --faint: #A79F93;
    --rule: #E5DECE;
    --shadow: 62 48 30;
    /* Object colours. These are the palette; there is no single accent. */
    --plastic: #F4703A;
    --plastic-mid: #E05A22;
    --plastic-dark: #B8410F;
    --barrel: #23262B;
    --glass: #4C7FB5;
    --paper: #FCFAF5;
    --board: #2F5D4B;
    --card-a: #4A2C66;
    --card-b: #E3B85A;
    --manila: #EBD9A9;
    --manila-dark: #C8AE73;
    --pencil: #55524E;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bench: #1A1916;
      --bench-2: #14130F;
      --ink: #F2EEE6;
      --muted: #A79F94;
      --faint: #6E675E;
      --rule: #33302A;
      --shadow: 0 0 0;
      --paper: #EDE7DA;
    }
  }
  :root[data-theme="dark"] {
    --bench: #1A1916; --bench-2: #14130F; --ink: #F2EEE6; --muted: #A79F94;
    --faint: #6E675E; --rule: #33302A; --shadow: 0 0 0; --paper: #EDE7DA;
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }

  body {
    margin: 0;
    background-color: var(--bench);
    background-image: none;
    color: var(--ink);
    font-family: Figtree, ui-sans-serif, system-ui, sans-serif;
    line-height: 1.5;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(1.1rem, 4vw, 2.2rem); }

  /* ---------------- hero: four lines, then stop ---------------- */
  header { padding: clamp(2.4rem, 8vh, 4.4rem) 0 1.2rem; }
  h1 {
    font-family: Fraunces, Georgia, serif;
    font-variation-settings: "SOFT" 50, "opsz" 90;
    font-weight: 700; letter-spacing: -0.02em;
    font-size: clamp(3rem, 11vw, 6.2rem); line-height: 0.88; margin: 0;
  }
  .disciplines {
    font-size: clamp(0.95rem, 2.4vw, 1.15rem); font-weight: 500;
    letter-spacing: 0.01em; margin-top: 0.7rem; color: var(--ink);
  }
  .disciplines span { color: var(--faint); padding: 0 0.15rem; }
  .move { font-size: clamp(0.9rem, 2.2vw, 1.02rem); color: var(--muted); margin-top: 0.2rem; }
  .say { margin: 1.1rem 0 0; font-size: clamp(1rem, 2.4vw, 1.18rem); max-width: 30ch; }
  .links { display: flex; gap: 0.55rem; flex-wrap: wrap; margin-top: 1.35rem; }
  .lnk {
    display: inline-block; padding: 0.55rem 1rem; border-radius: 999px;
    font-size: 0.9rem; font-weight: 600; text-decoration: none;
    background: var(--ink); color: var(--bench);
    transition: transform .14s cubic-bezier(.2,.9,.3,1.4);
  }
  .lnk.alt { background: transparent; color: var(--ink); border: 1.5px solid var(--rule); }
  .lnk:hover { transform: translateY(-2px) rotate(-1deg); }

  /* ---------------- the bench ---------------- */
  .benchwrap { position: relative; margin-top: clamp(0.5rem, 3vh, 1.4rem); }
  .hint {
    font-family: Fraunces, Georgia, serif; font-style: italic; font-size: 0.98rem;
    color: var(--faint); margin: 0 0 0.2rem;
    padding-left: max(calc(50vw - 590px + 1.1rem), clamp(1.1rem, 4vw, 2.2rem));
  }
  .hint b { color: var(--muted); font-weight: 400; }

  /* The bench is the page. A frame around it made the whole thing read
     as a canvas widget instead of a surface with things on it. */
  .benchwrap { margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); width: 100vw; }
  #bench {
    position: relative; width: 100%;
    height: clamp(520px, 76vh, 780px);
    background:
      radial-gradient(120% 80% at 50% 42%, var(--bench) 52%, var(--bench-2) 100%);
    overflow: hidden;
    touch-action: manipulation;
  }

  .obj {
    position: absolute; left: 0; top: 0;
    transform-origin: 50% 50%;
    cursor: grab; user-select: none; -webkit-user-select: none;
    touch-action: none;
    will-change: transform;
  }
  .obj:active { cursor: grabbing; }
  .obj svg { display: block; overflow: visible; pointer-events: none; }
  .obj .art {
    filter: drop-shadow(0 2px 1px rgb(var(--shadow) / 0.16)) drop-shadow(0 10px 16px rgb(var(--shadow) / 0.13));
    transition: filter .18s ease, transform .18s cubic-bezier(.2,.9,.3,1.4);
  }
  .obj.held .art { filter: drop-shadow(0 3px 2px rgb(var(--shadow) / 0.1)) drop-shadow(0 26px 34px rgb(var(--shadow) / 0.24)); transform: scale(1.04); }
  .obj:focus-visible { outline: none; }
  .obj:focus-visible .art { filter: drop-shadow(0 0 0 3px var(--glass)); }

  /* the small always-visible label on each object's face */
  /* Not captions. Things jotted on the bench beside the object, which
     is why they sit off to one side and lean. */
  .tag {
    position: absolute; white-space: nowrap; pointer-events: none;
    font-family: Fraunces, Georgia, serif; font-style: italic;
    font-size: 1rem; color: var(--muted);
  }

  /* the reveal, pinned to its object, counter-rotated so text stays level */
  .say-more {
    position: absolute; left: 50%; top: 100%;
    transform: translate(-50%, 22px);
    width: max(190px, 15rem);
    background: var(--bench); border: 1.5px solid var(--rule);
    border-radius: 12px; padding: 0.62rem 0.75rem;
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity .2s ease, transform .2s cubic-bezier(.2,.9,.3,1.4);
    box-shadow: 0 8px 18px rgb(var(--shadow) / 0.12);
    z-index: 5;
  }
  .obj.open .say-more { opacity: 1; visibility: visible; transform: translate(-50%, 14px); }
  .say-more p { margin: 0; font-size: 0.87rem; line-height: 1.4; }
  .say-more .n {
    display: inline-block; margin-top: 0.4rem; font-weight: 600;
    font-size: 0.78rem;
    color: var(--muted); border-top: 1px solid var(--rule); padding-top: 0.35rem;
  }

  /* the pencil note that only appears when the lens meets the clipboard */
  #note {
    position: absolute; z-index: 8; pointer-events: none;
    font-family: Fraunces, Georgia, serif; font-style: italic;
    font-size: 0.95rem; color: var(--pencil);
    opacity: 0; transform: translate(-50%, -50%) rotate(-6deg);
    transition: opacity .5s ease;
  }
  #note.on { opacity: 1; }

  /* ---------------- footer ---------------- */
  footer { padding: 1.5rem 0 3.4rem; }
  .where { font-size: 0.9rem; color: var(--muted); line-height: 1.9; }
  .where b { color: var(--ink); font-weight: 500; }
  .where i { color: var(--faint); font-style: normal; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 720px) {
    #bench { height: 74vh; border-radius: 14px; }
    .say-more { width: 12.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition-duration: .01ms !important; }
  }
</style>

<div class="wrap">
  <header>
    <h1>Ty Pleban</h1>
